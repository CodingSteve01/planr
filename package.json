{
  "name": "planr",
  "private": true,
  "version": "1.7.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "e2e": "npm run build && playwright test",
    "e2e:only": "playwright test",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:obsidian": "node obsidian/esbuild.config.mjs",
    "obsidian:install": "node obsidian/install.mjs",
    "version:set": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "lint:prune": "eslint . --prune-suppressions",
    "test:coverage": "vitest run --coverage",
    "dup": "jscpd",
    "deadcode": "knip --no-progress --include files,dependencies,unlisted,binaries,unresolved",
    "deadcode:exports": "knip --no-progress --include exports,types",
    "private": "node scripts/check-private.mjs",
    "quality": "npm run format:check && npm run lint && npm run dup && npm run deadcode && npm run version:check && npm run security && npm run private",
    "security": "node scripts/security.mjs",
    "hooks": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs --quiet",
    "security:advice": "node scripts/security.mjs --advice",
    "security:test": "node scripts/security.mjs --selftest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.20.1",
    "buffer": "^6.0.3",
    "pdfmake": "^0.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.3",
    "knip": "^6.47.0",
    "postcss": "^8.5.28",
    "prettier": "^3.10.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
