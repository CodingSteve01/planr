{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx vitest run:*)",
      "Bash(npx eslint:*)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run build:obsidian)",
      "Bash(npm run obsidian:install:*)",
      "Bash(node obsidian/install.mjs:*)",
      "Bash(node scripts/version.mjs:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Bash(npm run dev:*)",
      "Bash(npm run preview:*)",
      "Bash(npx vite dev:*)",
      "Bash(npx vite serve:*)",
      "Bash(npx vite preview:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
