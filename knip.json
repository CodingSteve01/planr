{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "obsidian/src/main.jsx",
    "obsidian/src/filePickers.js",
    "obsidian/src/fileHandleStore.js",
    "scripts/*.mjs",
    "tools/*.mjs",
    "vitest.worktree.config.js",
    "e2e/*.spec.js",
    "src/**/__tests__/**/*.{js,jsx}",
    "obsidian/__tests__/**/*.{js,jsx}"
  ],
  "project": ["src/**/*.{js,jsx}", "e2e/**/*.js", "obsidian/**/*.{js,jsx,mjs}", "scripts/**/*.mjs", "tools/**/*.mjs"],
  "ignoreDependencies": ["buffer"],
  "ignoreBinaries": ["semgrep"]
}
